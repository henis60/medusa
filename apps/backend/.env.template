STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Generează valori unice per mediu: openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-backend
# Nivelul de logare (implicit „http", care include info). Pe „warn" dispar toate
# liniile `logger.info` — inclusiv diagnosticele Netopia și Oblio.
LOG_LEVEL=info
# Baza din care se compun URL-urile publice ale backendului, printre care
# notifyUrl-ul trimis Netopiei. Nesetată, cade pe http://localhost:9000 și
# Netopia nu are unde să trimită IPN-ul — tăcut, fără nicio eroare.
BACKEND_URL=http://localhost:9000
# Storefront-ul: din el se compune redirectUrl-ul post-plată.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# --- Brevo email notification provider ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=Your Store Name
BREVO_NEWSLETTER_LIST_ID=
RECAPTCHA_SECRET_KEY=
CONTACT_RECIPIENT_EMAIL=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Netopia Payments provider ---
# Copiate direct din panoul Netopia sandbox/live:
NETOPIA_API_KEY=             # String scurt din Profile → Security → API Keys (Authorization header)
NETOPIA_ID=                  # POS signature (XXXX-XXXX-XXXX-XXXX-XXXX)
NETOPIA_SECRET=              # Cheie RSA privată merchant (PKCS#8 base64) — pentru semnare/IPN
NETOPIA_PUBLIC=              # Cheia de verificare IPN de la Netopia. Acceptă AMBELE
                             # formate pe care le distribuie: cheie publică SPKI
                             # („BEGIN PUBLIC KEY") sau certificat X.509
                             # („BEGIN CERTIFICATE"). Trebuie să fie din ACELAȘI
                             # mediu (sandbox/live) cu restul cheilor, altfel
                             # semnătura nu se validează.
NETOPIA_TEST_MODE=true       # false pentru producție
# NOTĂ: verificarea semnăturii IPN este OBLIGATORIE (fail-closed) — orice IPN
# fără semnătură validă primește 401. Schema, confirmată cu trafic real:
# header „Verification-token" = JWT semnat RSA (RS512), cu iss="NETOPIA Payments",
# aud = NETOPIA_ID și sub = base64(sha512(corpul BRUT al cererii)).
# La respingere, logul spune exact care verificare a picat (semnătură, iss, aud
# sau hash). Comenzile se finalizează oricum prin polling pe pagina de return.
# URL-urile se construiesc automat din BACKEND_URL și NEXT_PUBLIC_BASE_URL.
# Suprascrie doar dacă ai nevoie de alt path:
# NETOPIA_NOTIFY_URL=
# NETOPIA_REDIRECT_URL=
# Provider id registered by Medusa (pp_{identifier}_{config-id})
NETOPIA_PROVIDER_ID=pp_netopia_netopia

# --- eAWB / Europarcel fulfillment provider ---
EAWB_API_KEY=                        # API key din contul Europarcel/eAWB
EAWB_DRY_RUN=true                    # true în dev — createOrder nu apelează API-ul real
# Secret partajat cu storefront-ul pentru rutele /store/eawb/* (expun adresa de
# livrare a coșului și nu pot cere autentificare — checkout-ul ca invitat nu are
# sesiune). Generează cu: openssl rand -base64 32
# Trebuie setat cu ACEEAȘI valoare și în storefront (EAWB_INTERNAL_SECRET).
# Nesetat = rutele rămân publice (doar un avertisment la pornire).
EAWB_INTERNAL_SECRET=

# --- Oblio (facturare) ---
# OBLIO_DRY_RUN=true scurtcircuitează TOȚI pașii înainte de orice apel HTTP:
# token, emitere și PDF sunt fictive. Pe „false" se emit FACTURI FISCALE REALE,
# care se pot anula doar prin storno — testează pe o comandă sacrificabilă.
OBLIO_DRY_RUN=true
# Obligatorii (credențiale, trimise la /api/authorize):
OBLIO_CLIENT_ID=
OBLIO_CLIENT_SECRET=
# Obligatoriu în payload-ul facturii (câmpul `cif`). Absența lui aruncă explicit
# la emitere — vezi requireOblioCui() în src/workflows/steps/oblio-get-token.ts.
OBLIO_CUI=
# Trebuie să fie EXACT seria configurată în contul tău Oblio. Implicit „FCT",
# ceea ce nu e o eroare de sintaxă, dar poate emite pe o serie inexistentă.
OBLIO_INVOICE_SERIES=FCT
# Opționale, cu valori implicite rezonabile:
OBLIO_DOCUMENT_TYPE=Factura   # tipul documentului
OBLIO_VAT_PERCENTAGE=21       # TVA standard România
OBLIO_COMPANY_NAME=           # folosit doar în PDF-ul generat în DRY_RUN
